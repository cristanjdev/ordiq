# ==============================================================================
# ORDIQ Environment Configuration
# Copy this file to .env and fill in the required values.
# ==============================================================================

# --- Database (PostgreSQL / Supabase) ---
POSTGRES_USER=ordiq
POSTGRES_PASSWORD=ordiq_dev_password
POSTGRES_DB=ordiq
# Supabase: use the SESSION pooler (port 5432) for DATABASE_URL, e.g.
#   postgresql://USER:PASS@aws-0-REGION.pooler.supabase.com:5432/postgres?connection_limit=8&pool_timeout=20
# ORDIQ runs as a long-lived Node server (output: "standalone") with its own
# connection pool. The transaction pooler (port 6543 with pgbouncer=true) is
# meant for serverless hosts and costs several network round trips per query.
# Keep connection_limit below the pooler's client limit (Supabase dashboard).
# Pick the Supabase region nearest the users (Philippines: ap-southeast-1).
DATABASE_URL=postgresql://ordiq:ordiq_dev_password@localhost:5432/ordiq?schema=public
DIRECT_URL=postgresql://ordiq:ordiq_dev_password@localhost:5432/ordiq?schema=public

# --- Web Security & Auth ---
# Minimum 32 characters each
AUTH_SECRET=dev-auth-secret-change-in-production-32chars
APP_ENCRYPTION_KEY=dev-encryption-key-change-in-prod-32c

# All data (the Dean account, sessions, master data, schedules, AI
# conversations, audit log) is stored in the database above; there is no
# in-memory mode outside the automated tests. Before the first run:
#   pnpm --filter @ordiq/web exec prisma db push     (create the tables)
#   pnpm --filter @ordiq/web seed:dean               (create the Dean account)

# Session cookie "Secure" flag. Defaults to true in production. Set to "false"
# ONLY when serving over plain http:// on a trusted network (browsers discard
# Secure cookies on http:// origins, so sign-in would appear to do nothing).
# AUTH_COOKIE_SECURE=false

# Origin the route guard uses to validate sessions against this same server.
# Only needed if the public origin is not reachable from the server itself
# (e.g. behind a proxy); defaults to the incoming request origin.
# AUTH_INTERNAL_ORIGIN=http://127.0.0.1:3000

# --- Engine Connection ---
ENGINE_URL=http://localhost:8000
ENGINE_TOKEN=dev-engine-shared-secret-token-32chars

# --- AI Provider (change these to switch provider, no code change) ---
# Allowed: openai | anthropic | gemini | ollama | offline
# The assistant calls the provider only when it is usable: openai/anthropic/gemini need
# a real LLM_API_KEY (placeholder keys are ignored); ollama needs LLM_BASE_URL
# pointing at a running Ollama server. Otherwise, and under tests, it answers with
# the built-in deterministic assistant. If a provider call fails, it falls back to
# the built-in assistant for that turn.
# Default models when LLM_MODEL is empty: openai gpt-5.4-mini,
# anthropic claude-haiku-5-5, gemini gemini-3.5-flash, ollama qwen2.5:7b.
# Free option: LLM_PROVIDER=gemini with a Google AI Studio key
# (https://aistudio.google.com/apikey). On the free tier Google may use prompts
# to improve its products; faculty names are already pseudonymized.
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=sk-placeholder-dev-key
# Used for ollama (OpenAI-compatible endpoint). For openai it is used only when
# it is not the local Ollama address (e.g. a proxy).
LLM_BASE_URL=http://localhost:11434/v1
LLM_MONTHLY_TOKEN_BUDGET=500000
# Cost estimate in PHP per 1,000 tokens (shown in AI usage; ollama is always 0)
# LLM_COST_PHP_PER_1K_IN=0.009
# LLM_COST_PHP_PER_1K_OUT=0.035

# --- Engine Solver Tuning ---
SOLVER_TIME_LIMIT_SECONDS=120
SOLVER_WORKERS=4

