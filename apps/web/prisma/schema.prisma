generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// 1. Authentication, Sessions & Audit Log (Phase 1A)
// ============================================================================

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  username            String    @unique
  email               String    @unique
  role                String    @default("DEAN")
  passwordHash        String    @map("password_hash")
  totpSecretEncrypted String?   @map("totp_secret_encrypted")
  totpEnrolled        Boolean   @default(false) @map("totp_enrolled")
  /// Last accepted TOTP time step (unix seconds / 30); a code is never accepted twice.
  totpLastUsedStep    Int?      @map("totp_last_used_step")
  recoveryCodesHashes Json      @default("[]") @map("recovery_codes_hashes")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  sessions Session[]

  @@map("users")
}

model Session {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  tokenHash         String   @unique @map("token_hash")
  stage             String   @default("ACTIVE") // ENROLL_TOTP | VERIFY_TOTP | ACTIVE
  ipAddress         String?  @map("ip_address")
  userAgent         String?  @map("user_agent")
  lastActiveAt      DateTime @default(now()) @map("last_active_at")
  idleExpiresAt     DateTime @map("idle_expires_at")
  absoluteExpiresAt DateTime @map("absolute_expires_at")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([idleExpiresAt])
  @@map("sessions")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actor     String
  action    String
  entity    String
  entityId  String   @map("entity_id")
  before    Json?
  after     Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Dean-editable system settings (Settings page). One row per settings group;
/// `value` holds the group's fields as JSON and is validated in code.
model SystemSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ============================================================================
// 2. Domain data (D-25: state repository)
//
// These tables mirror the domain records in
// `src/server/modules/master-data/master-data.store.ts` one-to-one and are
// read and written only by `src/server/repo/state.repository.ts`.
//
// - Primary keys are the record `id` (UUIDs for anything the app creates;
//   learned preferences and solver entries use deterministic string IDs).
// - Ownership references use the college's stable codes (FAC-001, CE-1A, ...)
//   as foreign keys, so a row is readable without joins.
// - Schedules are historical snapshots: their entries keep plain codes with no
//   foreign keys, so archived schedules survive master-data deletions.
// - Section-level counts only (D-21). No individual student tables exist.
// ============================================================================

model Term {
  id           String   @id
  code         String   @unique
  academicYear String   @map("academic_year")
  semester     Int
  status       String   @default("DRAFT") // DRAFT | READY | ACTIVE | ARCHIVED
  slotSizeMin  Int      @default(30) @map("slot_size_min")
  teachingDays Json     @map("teaching_days")
  dayStartMin  Int      @default(450) @map("day_start_min") // 7:30 AM
  dayEndMin    Int      @default(1230) @map("day_end_min") // 8:30 PM
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  offerings           Offering[]
  fixedBlocks         FixedBlock[]
  facultyAvailability FacultyAvailability[]
  facultyPreferences  FacultyPreference[]
  directives          Directive[]

  @@map("terms")
}

model Program {
  id          String   @id
  code        String   @unique
  name        String
  coordinator String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sections Section[]

  @@map("programs")
}

model Faculty {
  id             String   @id
  code           String   @unique
  alias          String   @unique // Pseudonym used exclusively by the LLM privacy gateway
  name           String
  programCode    String?  @map("program_code")
  employmentType String   @map("employment_type") // FULL_TIME_PERMANENT | FULL_TIME_NON_PERMANENT | PART_TIME | VISITING
  specialization String
  education      String
  maxLoadUnits   Float    @default(21) @map("max_load_units")
  maxLoadHours   Float    @default(24) @map("max_load_hours")
  status         String   @default("ACTIVE") // ACTIVE | ON_LEAVE | INACTIVE
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  availability   FacultyAvailability[]
  qualifications FacultyQualification[]
  preferences    FacultyPreference[]

  @@index([programCode])
  @@map("faculty")
}

model Subject {
  id                  String   @id
  code                String   @unique
  name                String
  description         String   @default("")
  programCode         String?  @map("program_code")
  yearLevel           Int      @map("year_level")
  category            String // MAJOR | GENERAL_ENGINEERING | MATHEMATICS | SCIENCE | GENERAL_EDUCATION | PATHFIT
  units               Float
  contactHours        Float    @map("contact_hours")
  lectureHours        Float    @default(3) @map("lecture_hours")
  labHours            Float    @default(0) @map("lab_hours")
  curriculumVersion   String   @default("2024") @map("curriculum_version")
  isCurrentCurriculum Boolean  @default(true) @map("is_current_curriculum")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  qualifications FacultyQualification[]
  offerings      Offering[]

  @@index([programCode, yearLevel])
  @@map("subjects")
}

model Section {
  id           String   @id
  code         String   @unique
  programCode  String   @map("program_code")
  yearLevel    Int      @map("year_level")
  studentCount Int      @map("student_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  program     Program      @relation(fields: [programCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  offerings   Offering[]
  fixedBlocks FixedBlock[]

  @@index([programCode, yearLevel])
  @@map("sections")
}

model Room {
  id           String   @id
  code         String   @unique
  name         String
  type         String // LECTURE | LAB
  capacity     Int
  equipment    Json     @default("[]")
  restrictions String   @default("")
  status       String   @default("ACTIVE") // ACTIVE | MAINTENANCE | INACTIVE
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([type, capacity])
  @@map("rooms")
}

model Offering {
  id                     String   @id
  code                   String   @unique
  termCode               String   @map("term_code")
  sectionCode            String   @map("section_code")
  subjectCode            String   @map("subject_code")
  component              String   @default("LECTURE") // LECTURE | LAB
  meetingsPerWeek        Int      @default(2) @map("meetings_per_week")
  minutesPerMeeting      Int      @default(90) @map("minutes_per_meeting")
  meetingPattern         String   @default("ANY") @map("meeting_pattern") // MWF | TTH | SINGLE | ANY
  requiredRoomType       String   @default("LECTURE") @map("required_room_type") // LECTURE | LAB
  preassignedFacultyCode String?  @map("preassigned_faculty_code")
  combinedClassGroup     String?  @map("combined_class_group")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  term    Term    @relation(fields: [termCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  section Section @relation(fields: [sectionCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  subject Subject @relation(fields: [subjectCode], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@index([termCode])
  @@index([sectionCode])
  @@map("offerings")
}

model FixedBlock {
  id          String   @id
  naturalKey  String   @unique @map("natural_key") // termCode:sectionCode:weekday:startMin
  termCode    String   @map("term_code")
  sectionCode String   @map("section_code")
  weekday     String
  startMin    Int      @map("start_min")
  endMin      Int      @map("end_min")
  label       String
  location    String   @default("External")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  term    Term    @relation(fields: [termCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  section Section @relation(fields: [sectionCode], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@index([termCode, sectionCode])
  @@map("fixed_blocks")
}

model FacultyAvailability {
  id          String   @id
  naturalKey  String   @unique @map("natural_key") // termCode:facultyCode:weekday:startMin
  facultyCode String   @map("faculty_code")
  termCode    String   @map("term_code")
  weekday     String
  startMin    Int      @map("start_min")
  endMin      Int      @map("end_min")
  status      String   @default("AVAILABLE") // AVAILABLE | UNAVAILABLE
  reason      String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  faculty Faculty @relation(fields: [facultyCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  term    Term    @relation(fields: [termCode], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@index([termCode, facultyCode])
  @@map("faculty_availability")
}

model FacultyQualification {
  id          String   @id
  naturalKey  String   @unique @map("natural_key") // facultyCode:subjectCode
  facultyCode String   @map("faculty_code")
  subjectCode String   @map("subject_code")
  source      String   @default("DECLARED") // DECLARED | HISTORY | DEAN
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  faculty Faculty @relation(fields: [facultyCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  subject Subject @relation(fields: [subjectCode], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@index([subjectCode])
  @@map("faculty_qualifications")
}

model FacultyPreference {
  id          String   @id
  naturalKey  String   @unique @map("natural_key") // termCode:facultyCode:type:value, or the id for LEARNED rows
  facultyCode String   @map("faculty_code")
  termCode    String   @map("term_code")
  type        String // PREFERRED_DAY | AVOID_DAY | PREFERRED_TIME_WINDOW | PREFERRED_ROOM
  value       String
  weight      Float    @default(1.0)
  source      String   @default("SURVEY") // SURVEY | LEARNED | DEAN
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  faculty Faculty @relation(fields: [facultyCode], references: [code], onUpdate: Cascade, onDelete: Restrict)
  term    Term    @relation(fields: [termCode], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@index([termCode, facultyCode])
  @@map("faculty_preferences")
}

// Closed set of Dean/chat scheduling directives (D-16). Codes are kept as plain
// strings because a directive may outlive the record it names.
model Directive {
  id           String   @id
  termCode     String   @map("term_code")
  type         String
  hardness     String // HARD | SOFT
  approved     Boolean  @default(false)
  facultyCode  String?  @map("faculty_code")
  sectionCode  String?  @map("section_code")
  roomCode     String?  @map("room_code")
  offeringCode String?  @map("offering_code")
  weekday      String?
  startMin     Int?     @map("start_min")
  endMin       Int?     @map("end_min")
  weight       Float    @default(1.0)
  createdBy    String   @map("created_by")
  createdAt    DateTime @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  term Term @relation(fields: [termCode], references: [code], onUpdate: Cascade, onDelete: Restrict)

  @@index([termCode])
  @@map("directives")
}

// ============================================================================
// 3. Scheduling
// ============================================================================

model GenerationRun {
  id                   String    @id
  termCode             String    @map("term_code")
  status               String // QUEUED | RUNNING | DONE | FAILED | CANCELLED | SOLVER_MODEL_BUG
  profiles             Json      @default("[]")
  candidateScheduleIds Json      @default("[]") @map("candidate_schedule_ids")
  error                String?
  createdAt            DateTime  @map("created_at")
  completedAt          DateTime? @map("completed_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([termCode, status])
  @@map("generation_runs")
}

model Schedule {
  id               String    @id
  termCode         String    @map("term_code")
  runId            String?   @map("run_id")
  parentScheduleId String?   @map("parent_schedule_id")
  candidateLabel   String    @map("candidate_label")
  profileName      String?   @map("profile_name")
  status           String    @default("CANDIDATE") // CANDIDATE | ACCEPTED | ARCHIVED
  source           String    @default("GENERATED") // GENERATED | IMPORTED
  solverStatus     String?   @map("solver_status")
  optimalityGapPct Float?    @map("optimality_gap_pct")
  recheckNeeded    Boolean   @default(false) @map("recheck_needed")
  version          Int       @default(1)
  qualityScore     Float?    @map("quality_score")
  unscheduled      Json?
  exceptions       Json? // documented exceptions (D-18)
  changes          Json? // edit history shown in the workspace
  validationReport Json?     @map("validation_report")
  acceptedAt       DateTime? @map("accepted_at")
  acceptedBy       String?   @map("accepted_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  entries   ScheduleEntry[]
  proposals ChangeProposal[]

  @@index([termCode, status])
  @@map("schedules")
}

// Entry IDs come from the solver (ENT-<offering>-<meeting>) and repeat across
// candidates, so they are unique per schedule.
model ScheduleEntry {
  scheduleId   String  @map("schedule_id")
  id           String
  position     Int
  offeringCode String  @map("offering_code")
  meetingIndex Int?    @map("meeting_index")
  facultyCode  String  @map("faculty_code")
  roomCode     String  @map("room_code")
  weekday      String
  startMin     Int     @map("start_min")
  endMin       Int     @map("end_min")
  pinned       Boolean @default(false)

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@id([scheduleId, id])
  @@index([scheduleId, weekday, startMin])
  @@index([scheduleId, facultyCode])
  @@index([scheduleId, roomCode])
  @@map("schedule_entries")
}

model ChangeProposal {
  id                    String    @id
  scheduleId            String    @map("schedule_id")
  termCode              String    @map("term_code")
  status                String    @default("PENDING") // PENDING | APPLIED | REJECTED
  summary               String
  offeringCode          String    @map("offering_code")
  meetingIndex          Int       @map("meeting_index")
  beforeEntry           Json      @map("before_entry")
  afterEntry            Json      @map("after_entry")
  qualityDelta          Float     @map("quality_delta")
  resultingQualityScore Float     @map("resulting_quality_score")
  valid                 Boolean
  createdBy             String    @map("created_by")
  createdAt             DateTime  @map("created_at")
  resolvedAt            DateTime? @map("resolved_at")

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, status])
  @@map("change_proposals")
}

// ============================================================================
// 4. AI, ML, imports and evaluation
// ============================================================================

model Conversation {
  id        String   @id
  termCode  String   @map("term_code")
  title     String   @default("New Conversation")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  messages Message[]

  @@map("conversations")
}

model Message {
  id             String   @id
  conversationId String   @map("conversation_id")
  position       Int
  role           String // user | assistant
  content        String
  parts          Json     @default("[]")
  createdAt      DateTime @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, position])
  @@map("messages")
}

// Token counts only, never message content.
model LlmUsage {
  id               String   @id
  provider         String
  model            String
  tokensIn         Int      @map("tokens_in")
  tokensOut        Int      @map("tokens_out")
  estimatedCostPhp Float    @default(0) @map("estimated_cost_php")
  createdAt        DateTime @map("created_at")

  @@index([createdAt])
  @@map("llm_usage")
}

// ML parameters as JSON, never pickles (D-11).
model ModelVersion {
  id            String   @id
  versionNumber Int      @map("version_number")
  kind          String // FACULTY_FIT | PREFERENCE_MODEL
  status        String   @default("ACTIVE") // ACTIVE | CANDIDATE | ARCHIVED
  parameters    Json
  metrics       Json
  trainedAt     DateTime @map("trained_at")

  @@index([kind, status])
  @@map("model_versions")
}

model LearningEvent {
  id          String   @id
  termCode    String   @map("term_code")
  scheduleId  String   @map("schedule_id")
  type        String // SCHEDULE_ACCEPTED | DEAN_EDIT
  facultyCode String   @map("faculty_code")
  subjectCode String   @map("subject_code")
  weekday     String
  startMin    Int      @map("start_min")
  weight      Float    @default(1.0)
  createdAt   DateTime @map("created_at")

  @@index([createdAt])
  @@index([facultyCode])
  @@map("learning_events")
}

model ImportBatch {
  id            String   @id
  termCode      String?  @map("term_code")
  dataset       String // WORKBOOK | PAST_SCHEDULE | PREFERENCES
  fileHash      String   @map("file_hash")
  status        String // DRY_RUN | COMMITTED | FAILED
  rowCount      Int      @default(0) @map("row_count")
  insertedCount Int      @default(0) @map("inserted_count")
  updatedCount  Int      @default(0) @map("updated_count")
  errors        Json     @default("[]")
  createdAt     DateTime @map("created_at")

  @@index([fileHash])
  @@map("import_batches")
}

// Evaluation evidence for the paper (D-24).
model EvaluationSession {
  id                  String    @id
  termCode            String    @map("term_code")
  stage               String // STAGE_1_BASELINE | STAGE_2_CONFLICT_CHECK | STAGE_3_GENERATION
  scenario            String
  participantRole     String    @default("DEAN") @map("participant_role")
  scheduleId          String?   @map("schedule_id")
  startedAt           DateTime  @map("started_at")
  endedAt             DateTime? @map("ended_at")
  durationMinutes     Float?    @map("duration_minutes")
  correctionCount     Int       @default(0) @map("correction_count")
  conflictCountBefore Int       @default(0) @map("conflict_count_before")
  conflictCountAfter  Int       @default(0) @map("conflict_count_after")
  iso25010Ratings     Json?     @map("iso25010_ratings")
  notes               String    @default("")

  @@index([stage])
  @@map("evaluation_sessions")
}

// Single row (id = 1). `version` increases on every committed change so other
// server instances know to reload; `aliasCounter` feeds Faculty.alias.
model SystemState {
  id           Int      @id @default(1)
  version      Int      @default(0)
  aliasCounter Int      @default(0) @map("alias_counter")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("system_state")
}
