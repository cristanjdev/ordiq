{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "engine",
          "format": "url",
          "env": "ENGINE_URL"
        }
      ]
    },
    "engine": {
      "root": "services/engine",
      "framework": "fastapi",
      "entrypoint": "engine.main:app"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
